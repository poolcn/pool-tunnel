{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pool-tunnel",
  "version": "1.0.1",
  "identifier": "com.poolcn.tunnel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pool.cn.com矿池加密连接 V1.0.1",
        "width": 780,
        "height": 640,
        "minWidth": 680,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/gost"
    ],
    "category": "Utility",
    "shortDescription": "pool.cn.com 矿池加密连接",
    "longDescription": "pool.cn.com 矿池加密隧道客户端：拉取矿池列表、按币种选择端口、启动内嵌 GOST 建立加密转发隧道，支持在线矿机统计与上报。",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
